<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>DesktopFamiliar</AssemblyName>
    <RootNamespace>DesktopFamiliar</RootNamespace>
    <AssemblyTitle>Desktop Familiar</AssemblyTitle>
    <Product>Desktop Familiar</Product>
    <Company>Desktop Familiar</Company>
    <Description>An animated desktop-companion application for Windows.</Description>
    <Version>0.10.1</Version>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="DesktopFamiliar.AddonSdk\DesktopFamiliar.AddonSdk.csproj" />
    <Compile Remove="Addons\AutoClicker\**\*.cs" />
    <Compile Remove="DesktopFamiliar.AddonSdk\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <Resource Include="Assets\AppIcon.ico" />
    <Content Include="Resources\Licenses\SharpGLTF.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Resources\Licenses\SharpGLTF.txt" LogicalName="DesktopFamiliar.Licenses.SharpGLTF.txt" />
    <Content Include="Resources\Licenses\NAudio.txt;Resources\Licenses\System.Speech.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Resources\Licenses\NAudio.txt;Resources\Licenses\System.Speech.txt" LogicalName="DesktopFamiliar.Licenses.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources\Strings\en.json" LogicalName="DesktopFamiliar.Localization.Strings.en.json" />
    <InternalsVisibleTo Include="DesktopFamiliar.Tests" />
    <EmbeddedResource Include="Resources\chat-models.json" LogicalName="DesktopFamiliar.Resources.chat-models.json" />
    <EmbeddedResource Include="Resources\voice-banks.json" LogicalName="DesktopFamiliar.Resources.voice-banks.json" />
    <EmbeddedResource Include="Services\Updates\ApplyAppUpdate.ps1" LogicalName="DesktopFamiliar.Updates.ApplyAppUpdate.ps1" />
    <Content Include="Resources\Strings\en.json" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SharpGLTF.Runtime" Version="1.0.6" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>
</Project>
