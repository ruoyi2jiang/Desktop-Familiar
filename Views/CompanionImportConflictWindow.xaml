<Window x:Class="DesktopFamiliar.Views.CompanionImportConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DesktopFamiliar.Localization"
        Title="{loc:Loc CompanionBundle.Conflict.Title}"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Background="{DynamicResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,22,24,12">
            <TextBlock Text="{loc:Loc CompanionBundle.Conflict.Heading}" FontSize="21" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextOnPageBackgroundBrush}" />
            <TextBlock x:Name="ConflictMessage" Margin="0,10,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextOnPageBackgroundBrush}" />
        </StackPanel>

        <Border Grid.Row="1" Padding="20,14" Background="{DynamicResource SecondaryBackgroundBrush}"
                BorderBrush="{DynamicResource SecondaryAccentBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:Loc Common.Cancel}" Style="{StaticResource SecondaryOutlineButton}"
                        Margin="0,0,8,0" Click="Cancel_Click" />
                <Button Content="{loc:Loc CompanionBundle.Conflict.ImportAsNew}" Style="{StaticResource SecondaryOutlineButton}"
                        Margin="0,0,8,0" Click="ImportAsNew_Click" />
                <Button Content="{loc:Loc CompanionBundle.Conflict.Overwrite}" Style="{StaticResource SecondaryButton}"
                        Margin="0" Click="Overwrite_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
