<Window x:Class="DesktopFamiliar.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DesktopFamiliar.Localization"
        xmlns:controls="clr-namespace:DesktopFamiliar.Views.Controls"
        Title="{loc:Loc Settings.Window.Title}" Width="980" Height="720" MinWidth="780" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="SettingsSidebarItem" TargetType="RadioButton">
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnSecondaryBackgroundBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="MenuBar" Background="{TemplateBinding Background}" />
                            <Border x:Name="SelectionMark" Width="4" HorizontalAlignment="Left"
                                    Background="Transparent" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                              HorizontalAlignment="Left" Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="MenuBar" Property="Background" Value="{DynamicResource SecondaryBackgroundActiveBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnSecondaryBackgroundBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="SelectionMark" Property="Background" Value="{DynamicResource SecondaryAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MenuBar" Property="Background" Value="{DynamicResource SecondaryBackgroundHoverBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="MenuBar" Property="Background" Value="{DynamicResource SecondaryBackgroundActiveBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsTextInput" TargetType="TextBox" BasedOn="{StaticResource ThemedTextInput}" />
        <Style x:Key="SettingsDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource PrimaryAccentBrush}" />
            <Setter Property="Margin" Value="0,26" />
        </Style>
        <Style x:Key="SettingsAddonSwitcher" TargetType="RadioButton">
            <Setter Property="Padding" Value="0,0,0,7" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnPageBackgroundBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PageAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryAccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsAddonListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBackgroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemSurface" Background="{DynamicResource PrimaryBackgroundBrush}"
                                BorderBrush="{DynamicResource PrimaryAccentBrush}" BorderThickness="1" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource PrimaryBackgroundHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource PrimaryBackgroundActiveBrush}" />
                                <Setter TargetName="ItemSurface" Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}" />
                                <Setter TargetName="ItemSurface" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ThemeOption" TargetType="RadioButton">
            <Setter Property="Width" Value="150" />
            <Setter Property="Height" Value="112" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBackgroundBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ThemeCard" Background="{DynamicResource PrimaryBackgroundBrush}" BorderBrush="{DynamicResource PrimaryAccentBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThemeCard" Property="Background" Value="{DynamicResource PrimaryBackgroundHoverBrush}" />
                                <Setter TargetName="ThemeCard" Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ThemeCard" Property="Background" Value="{DynamicResource PrimaryBackgroundActiveBrush}" />
                                <Setter TargetName="ThemeCard" Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}" />
                                <Setter TargetName="ThemeCard" Property="BorderThickness" Value="2" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ThemeOptionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" />
        </Style>
        <Style x:Key="ThemeOptionDescription" TargetType="TextBlock" BasedOn="{StaticResource ThemeOptionTitle}">
            <Setter Property="Opacity" Value="0.74" />
        </Style>
    </Window.Resources>
    <Grid x:Name="SettingsRoot" Background="{DynamicResource PageBackgroundBrush}"
          TextElement.Foreground="{DynamicResource TextOnPageBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource SecondaryAccentBrush}" BorderThickness="0,0,1,0"
                TextElement.Foreground="{DynamicResource TextOnSecondaryBackgroundBrush}">
            <StackPanel>
                <TextBlock Text="{loc:Loc Settings.Menu.Title}" Foreground="{DynamicResource TextOnSecondaryBackgroundBrush}" FontSize="25" FontWeight="SemiBold" Margin="18,26,18,24" />
                <RadioButton x:Name="GeneralMenuButton" Content="{loc:Loc Settings.General.Menu}" IsChecked="True"
                             GroupName="SettingsPages" Style="{StaticResource SettingsSidebarItem}" Click="GeneralMenu_Click" />
                <RadioButton x:Name="UserMenuButton" Content="{loc:Loc Settings.User.Menu}"
                             GroupName="SettingsPages" Style="{StaticResource SettingsSidebarItem}" Click="UserMenu_Click" />
                <RadioButton x:Name="CompanionMenuButton" Content="{loc:Loc Settings.Companion.Menu}"
                             GroupName="SettingsPages" Style="{StaticResource SettingsSidebarItem}" Click="CompanionMenu_Click" />
                <RadioButton Content="{loc:Loc Chat.Title}" GroupName="SettingsPages" Style="{StaticResource SettingsSidebarItem}" Click="ChatMenu_Click" />
                <RadioButton x:Name="ThemeMenuButton" Content="{loc:Loc Settings.Theme.Menu}"
                             GroupName="SettingsPages" Style="{StaticResource SettingsSidebarItem}" Click="ThemeMenu_Click" />
                <RadioButton x:Name="AddonsMenuButton" Content="{loc:Loc Settings.Addons.Menu}"
                             GroupName="SettingsPages" Style="{StaticResource SettingsSidebarItem}" Click="AddonsMenu_Click" />
            </StackPanel>
        </Border>
        <ScrollViewer x:Name="SettingsPageScrollViewer" Grid.Column="1" Style="{StaticResource OverlayScrollViewer}" VerticalScrollBarVisibility="Auto">
            <Grid Margin="38,32">
                <StackPanel x:Name="GeneralPanel">
                    <TextBlock Text="{loc:Loc Settings.General.Title}" FontSize="27" FontWeight="SemiBold" />
                    <TextBlock Text="{loc:Loc Settings.General.Description}" Foreground="{DynamicResource TextOnPageBackgroundBrush}" Opacity="0.72" Margin="0,6,0,26" />
                    <CheckBox x:Name="RunAtStartupCheck" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Checked="RunAtStartup_Changed" Unchecked="RunAtStartup_Changed">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Settings.RunAtStartup.Title}" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Loc Settings.RunAtStartup.Description}" Foreground="{DynamicResource TextOnPageBackgroundBrush}" Opacity="0.72" Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </CheckBox>
                    <Border Style="{StaticResource SettingsDivider}" />
                    <TextBlock Text="{loc:Loc Settings.Updates.Title}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="InstalledAppVersion" Style="{StaticResource MutedPageTextBlock}" Margin="0,5,0,0" />
                    <TextBlock x:Name="AppUpdateStatus" TextWrapping="Wrap" Margin="0,8,0,12"
                               AutomationProperties.LiveSetting="Polite" />
                    <WrapPanel>
                        <Button x:Name="CheckAppUpdates" Content="{loc:Loc Settings.Updates.Check}"
                                Style="{StaticResource OutlineButton}" Click="CheckAppUpdates_Click" Margin="0,0,8,6" />
                        <Button x:Name="ApplyAppUpdate" Visibility="Collapsed" Click="ApplyAppUpdate_Click" Margin="0,0,8,6" />
                        <Button x:Name="SaveAppUpdate" Visibility="Collapsed" Content="{loc:Loc Settings.Updates.SaveCopy}"
                                Style="{StaticResource OutlineButton}" Click="SaveAppUpdate_Click" Margin="0,0,0,6" />
                    </WrapPanel>
                </StackPanel>

                <StackPanel x:Name="ChatPanel" Visibility="Collapsed">
                    <DockPanel Margin="0,0,0,20">
                        <ToggleButton x:Name="EnableChat" AutomationProperties.Name="{loc:Loc Chat.Enable}" Style="{StaticResource SettingsToggle}" DockPanel.Dock="Right" Click="EnableChat_Click" />
                        <TextBlock Text="{loc:Loc Chat.Title}" FontSize="27" FontWeight="SemiBold" />
                    </DockPanel>
                    <StackPanel x:Name="ChatOptions">
                        <controls:FieldHelpLabel Text="{loc:Loc Chat.Model}" HelpText="{loc:Loc Chat.ModelHelp}" />
                        <ComboBox x:Name="ChatModelChoice" SelectionChanged="ChatModel_Changed" DropDownClosed="ChatModel_Closed"
                                  ToolTip="{loc:Loc Chat.ModelHelp}" AutomationProperties.HelpText="{loc:Loc Chat.ModelHelp}" AutomationProperties.Name="{loc:Loc Chat.Model}" />
                        <TextBlock x:Name="ChatAvailability" TextWrapping="Wrap" Margin="0,6,0,20"/>
                        <TextBlock Text="{loc:Loc Chat.Shortcut}" FontWeight="SemiBold"/>
                        <TextBox x:Name="ChatShortcut" IsReadOnly="True" PreviewKeyDown="ChatShortcut_KeyDown" AutomationProperties.Name="{loc:Loc Chat.Shortcut}" />
                        <TextBlock x:Name="ShortcutHint" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <Border Style="{StaticResource SettingsDivider}" />
                        <DockPanel Margin="0,0,0,8">
                            <ToggleButton x:Name="EnableVoice" DockPanel.Dock="Right" Style="{StaticResource SettingsToggle}"
                                          AutomationProperties.Name="{loc:Loc Voice.Enable}" Click="EnableVoice_Click"/>
                            <TextBlock Text="{loc:Loc Voice.Input}" FontSize="20" FontWeight="SemiBold"/>
                        </DockPanel>
                        <StackPanel x:Name="VoiceOptions">
                            <Label Content="{loc:Loc Voice.InputLanguage}" Target="{Binding ElementName=VoiceLanguage}" Padding="0"/>
                            <ComboBox x:Name="VoiceLanguage" SelectionChanged="VoiceChoice_Changed"/>
                            <CheckBox x:Name="PreferWhisper" Click="PreferWhisper_Click" Margin="0,6,0,0"
                                      ToolTip="{loc:Loc Voice.PreferWhisperHelp}" AutomationProperties.HelpText="{loc:Loc Voice.PreferWhisperHelp}"
                                      AutomationProperties.Name="{loc:Loc Voice.PreferWhisper}" ToolTipService.InitialShowDelay="0">
                                <Border Background="Transparent">
                                    <controls:FieldHelpLabel Text="{loc:Loc Voice.PreferWhisper}" HelpText="{loc:Loc Voice.PreferWhisperHelp}" IsHitTestVisible="False"/>
                                </Border>
                            </CheckBox>
                            <TextBlock x:Name="RecognitionStatus" TextWrapping="Wrap" Margin="0,4"/>
                            <WrapPanel>
                                <Button x:Name="GetRecognizer" Click="GetRecognizer_Click" Margin="0,2,8,6"/>
                                <Button Content="{loc:Loc Voice.WindowsPacks}" Click="OpenSpeechPacks_Click" Margin="0,2,8,6"/>
                                <Button Content="{loc:Loc Voice.Refresh}" Click="RefreshVoice_Click" Margin="0,2,0,6"/>
                            </WrapPanel>
                            <Label Content="{loc:Loc Voice.Microphone}" Target="{Binding ElementName=VoiceDevice}" Padding="0" Margin="0,16,0,0"/>
                            <ComboBox x:Name="VoiceDevice" SelectionChanged="VoiceChoice_Changed"/>
                            <Button x:Name="TestMic" Content="{loc:Loc Voice.TestMic}" Click="TestMic_Click" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                            <TextBlock x:Name="MicStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                            <Label Content="{loc:Loc Voice.Shortcut}" Target="{Binding ElementName=TalkShortcut}" Padding="0" Margin="0,16,0,0"/>
                            <TextBox x:Name="TalkShortcut" IsReadOnly="True" PreviewKeyDown="ChatShortcut_KeyDown"/>
                            <TextBlock x:Name="TalkShortcutHint" TextWrapping="Wrap" Margin="0,4"/>
                            <CheckBox x:Name="VoiceAutoSend" Content="{loc:Loc Voice.SendOnRelease}" Click="AutoSend_Click" Margin="0,4"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Style="{StaticResource SettingsDivider}" />
                    <TextBlock Text="{loc:Loc Chat.History}" FontWeight="SemiBold" />
                    <TextBlock x:Name="TotalHistorySize" Style="{StaticResource MutedPageTextBlock}"
                               Margin="0,4,0,2" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,6,0,0">
                        <Button x:Name="ClearAllHistory" Content="{loc:Loc Chat.ClearAll}" Click="ClearAllHistory_Click" Margin="0,0,8,0" />
                        <Button x:Name="ManageHistory" Content="{loc:Loc Chat.Manage}" Click="ManageHistory_Click" Margin="0" />
                    </WrapPanel>
                </StackPanel>
                <StackPanel x:Name="UserPanel" Visibility="Collapsed">
                    <TextBlock Text="{loc:Loc Settings.User.Title}" FontSize="27" FontWeight="SemiBold" />
                    <TextBlock Text="{loc:Loc Settings.User.Description}" Foreground="{DynamicResource TextOnPageBackgroundBrush}" Opacity="0.72" Margin="0,6,0,26" TextWrapping="Wrap" />
                    <TextBlock Text="{loc:Loc Settings.User.Birthday}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Text="{loc:Loc Settings.User.Birthday.Description}" Foreground="{DynamicResource TextOnPageBackgroundBrush}" Opacity="0.72" Margin="0,0,0,12" TextWrapping="Wrap" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <DatePicker x:Name="UserBirthdayPicker" Grid.Column="0" Margin="0"
                                    SelectedDateFormat="Short" SelectedDateChanged="UserBirthdayPicker_SelectedDateChanged" />
                        <Button Grid.Column="2" Content="{loc:Loc Settings.User.Birthday.Clear}" Style="{StaticResource OutlineButton}"
                                Height="38" Padding="14,0" Margin="0" Click="ClearUserBirthday_Click" />
                    </Grid>
                </StackPanel>

                <Grid x:Name="AddonsPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <Button x:Name="RefreshAddonsButton" Style="{StaticResource OutlineButton}"
                                DockPanel.Dock="Right" Height="38" Padding="14,0" Margin="14,0,0,0" Click="RefreshAddons_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc Settings.Addons.Refresh}" VerticalAlignment="Center" />
                                <TextBlock x:Name="RefreshAddonsSpinner" Text="&#x27F3;" FontSize="16" Width="16" Height="16"
                                           Margin="8,0,0,0" TextAlignment="Center" LineHeight="16" VerticalAlignment="Center"
                                           Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform x:Name="RefreshAddonsSpinnerRotation" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{loc:Loc Settings.Addons.Title}" FontSize="27" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="{loc:Loc Settings.Addons.Description}" Foreground="{DynamicResource TextOnPageBackgroundBrush}" Opacity="0.72" Margin="0,6,0,12" TextWrapping="Wrap" />
                    <TextBlock x:Name="AddonsStatusText" Grid.Row="2" Foreground="{DynamicResource TextOnPageBackgroundBrush}" Opacity="0.72" Margin="0,0,0,14" TextWrapping="Wrap" />
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                        <RadioButton x:Name="AvailableAddonsTab" GroupName="AddonTabs" IsChecked="True"
                                     Style="{StaticResource SettingsAddonSwitcher}" Click="AvailableAddonsTab_Click" />
                        <Border Width="1" Height="20" Background="{DynamicResource SecondaryAccentBrush}" Opacity="0.7" Margin="14,0" />
                        <RadioButton x:Name="InstalledAddonsTab" GroupName="AddonTabs"
                                     Style="{StaticResource SettingsAddonSwitcher}" Click="InstalledAddonsTab_Click" />
                    </StackPanel>
                    <Grid x:Name="AvailableAddonsView" Grid.Row="4" MaxHeight="480">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer x:Name="AvailableAddonsListScrollViewer" Grid.Column="0" Style="{StaticResource OverlayScrollViewer}"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <ListBox x:Name="AvailableAddonsList" BorderThickness="0" Background="Transparent"
                                         ItemContainerStyle="{StaticResource SettingsAddonListItem}" SelectionChanged="AvailableAddonsList_SelectionChanged"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                                <TextBlock x:Name="AvailableAddonsEmptyText" Text="{loc:Loc Settings.Addons.NoneAvailable}"
                                           Opacity="0.72" TextWrapping="Wrap" Visibility="Collapsed" />
                            </Grid>
                        </ScrollViewer>
                        <Border x:Name="AvailableAddonDetailsBorder" Grid.Column="2" Background="{DynamicResource PrimaryBackgroundBrush}" BorderBrush="{DynamicResource PrimaryAccentBrush}"
                                BorderThickness="1" CornerRadius="10"
                                TextElement.Foreground="{DynamicResource TextOnPrimaryBackgroundBrush}" Visibility="Collapsed">
                            <ScrollViewer Style="{StaticResource OverlayScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="AvailableAddonDetailsPanel" Margin="18">
                                    <TextBlock x:Name="AvailableAddonTitleText" FontSize="21" FontWeight="SemiBold" />
                                    <TextBlock x:Name="AvailableAddonVersionText" Opacity="0.72" Margin="0,4,0,12" />
                                    <TextBlock x:Name="AvailableAddonDescriptionText" TextWrapping="Wrap" />
                                    <Button x:Name="AvailableAddonInstallButton" Content="{loc:Loc Settings.Addons.Install}" Style="{StaticResource PrimaryButton}"
                                            HorizontalAlignment="Left" Height="38" Padding="16,0" Margin="0,18,0,0" Click="InstallAddon_Click" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                    <StackPanel x:Name="InstalledAddonsView" Grid.Row="4" Visibility="Collapsed">
                        <TextBlock x:Name="InstalledAddonsEmptyText" Text="{loc:Loc Settings.Addons.NoneInstalled}"
                                   Opacity="0.72" TextWrapping="Wrap" Visibility="Collapsed" />
                        <StackPanel x:Name="InstalledAddonsList" />
                        <Border x:Name="AddonSettingsDivider" Style="{StaticResource SettingsDivider}" Visibility="Collapsed" />
                        <StackPanel x:Name="AddonSettingsSections" />
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="CompanionPanel" Visibility="Collapsed">
                    <TextBlock Text="{loc:Loc Settings.Companion.Title}" FontSize="27" FontWeight="SemiBold" />
                    <TextBlock Text="{loc:Loc Settings.Companion.Description}" Foreground="{DynamicResource TextOnPageBackgroundBrush}" Opacity="0.72" Margin="0,6,0,26" />
                    <TextBlock Text="{loc:Loc Settings.Companion.CharacterViewport.Title}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Text="{loc:Loc Settings.Companion.CharacterViewport.Description}" Foreground="{DynamicResource TextOnPageBackgroundBrush}" Opacity="0.72" Margin="0,0,0,16" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:Loc Settings.Companion.CharacterViewport.Width}" FontWeight="SemiBold" />
                            <TextBox x:Name="ViewportWidthBox" Style="{StaticResource SettingsTextInput}" Margin="0,7,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{loc:Loc Settings.Companion.CharacterViewport.Height}" FontWeight="SemiBold" />
                            <TextBox x:Name="ViewportHeightBox" Style="{StaticResource SettingsTextInput}" Margin="0,7,0,0" />
                        </StackPanel>
                    </Grid>
                    <Button Content="{loc:Loc Settings.Companion.CharacterViewport.Apply}" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left" Height="38" Padding="16,0" Margin="0,14,0,0" Click="ApplyViewport_Click" />
                    <Border Style="{StaticResource SettingsDivider}" />
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Settings.RandomIdleInterval.Title}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Loc Settings.RandomIdleInterval.Description}" Foreground="{DynamicResource TextOnPageBackgroundBrush}" Opacity="0.72" Margin="0,5,0,12" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="IdleIntervalBox" Style="{StaticResource SettingsTextInput}" Width="110" Margin="0" />
                            <TextBlock Text="{loc:Loc Settings.RandomIdleInterval.Seconds}" VerticalAlignment="Center" Margin="10,0,14,0" />
                            <Button Content="{loc:Loc Settings.RandomIdleInterval.Apply}" Style="{StaticResource PrimaryButton}" Height="38" Padding="16,0" Margin="0" Click="ApplyIdleInterval_Click" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="ThemePanel" Visibility="Collapsed">
                    <DockPanel Margin="0,0,0,18">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ComboBox x:Name="ThemeSourceComboBox" Width="178" ToolTip="{loc:Loc Settings.Theme.CreateFrom}" Margin="0,0,8,0" />
                            <Button Content="{loc:Loc Settings.Theme.Create}" Style="{StaticResource PrimaryButton}" Height="38" Padding="16,0" Margin="0" Click="CreateTheme_Click" />
                        </StackPanel>
                        <TextBlock Text="{loc:Loc Settings.Theme.Title}" FontSize="27" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <WrapPanel x:Name="ThemeOptionsPanel" />
                    <Border x:Name="ThemeEditor" Visibility="Collapsed" Background="{DynamicResource PrimaryBackgroundBrush}" BorderBrush="{DynamicResource PrimaryAccentBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,12,0,0"
                            TextElement.Foreground="{DynamicResource TextOnPrimaryBackgroundBrush}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Settings.Theme.Edit}" Foreground="{DynamicResource TextOnPrimaryBackgroundBrush}" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Loc Settings.Theme.Name}" FontWeight="SemiBold" Margin="0,16,0,0" />
                            <TextBox x:Name="ThemeNameBox" Style="{StaticResource SettingsTextInput}" Margin="0,7,0,14" />
                            <StackPanel x:Name="CustomThemeTokenPanel" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="{loc:Loc Settings.Theme.Save}" Style="{StaticResource PrimaryButton}" Height="38" Padding="16,0" Margin="0" Click="SaveTheme_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
