<Window x:Class="DesktopFamiliar.Views.ColorWheelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DesktopFamiliar.Localization"
        Title="{loc:Loc ColorWheel.Window.Title}" Width="410" Height="590" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24" Background="{DynamicResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="300" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{loc:Loc ColorWheel.FontColor}" Style="{StaticResource SectionTitle}"
                   Foreground="{DynamicResource TextOnPageBackgroundBrush}" />
        <Canvas Grid.Row="1" Width="300" Height="300" HorizontalAlignment="Center" MouseLeftButtonDown="Wheel_MouseLeftButtonDown" MouseMove="Wheel_MouseMove">
            <Image x:Name="WheelImage" Width="300" Height="300" />
            <Ellipse x:Name="SelectionMarker" Width="14" Height="14" Stroke="White" StrokeThickness="3" Fill="Transparent" IsHitTestVisible="False" />
        </Canvas>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="{loc:Loc ColorWheel.Brightness}" Style="{StaticResource FieldLabel}"
                       Foreground="{DynamicResource TextOnPageBackgroundBrush}" />
            <Slider x:Name="BrightnessSlider" Minimum="0.1" Maximum="1" Value="1" ValueChanged="BrightnessSlider_ValueChanged" />
        </StackPanel>
        <DockPanel Grid.Row="3" Margin="0,16,0,10">
            <Border x:Name="SelectedPreview" Width="60" Height="38" CornerRadius="8" BorderBrush="{DynamicResource InputAccentBrush}" BorderThickness="1" />
            <TextBlock x:Name="HexValue" VerticalAlignment="Center" Margin="12,0" FontFamily="Consolas" FontSize="15" />
        </DockPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:Loc Common.Cancel}" IsCancel="True" />
            <Button Content="{loc:Loc ColorWheel.Choose}" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Choose_Click" />
        </StackPanel>
    </Grid>
</Window>
