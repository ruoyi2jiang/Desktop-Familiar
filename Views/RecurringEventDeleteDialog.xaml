<Window x:Class="DesktopFamiliar.Views.RecurringEventDeleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DesktopFamiliar.Localization"
        Title="{loc:Loc Calendar.Delete.Recurring.Title}"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="{DynamicResource PrimaryBackgroundBrush}"
            BorderBrush="{DynamicResource PrimaryAccentBrush}"
            BorderThickness="1" CornerRadius="14" Padding="24">
        <StackPanel>
            <TextBlock Text="{loc:Loc Calendar.Delete.Recurring.Title}"
                       FontSize="21" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextOnPrimaryBackgroundBrush}" />
            <TextBlock x:Name="MessageText" Margin="0,12,0,22"
                       TextWrapping="Wrap" FontSize="14"
                       Foreground="{DynamicResource TextOnPrimaryBackgroundBrush}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="{loc:Loc Common.Cancel}"
                        Style="{StaticResource OutlineButton}" Height="38"
                        Padding="14,0" Margin="0" Click="Cancel_Click" />
                <Button Grid.Column="2" Content="{loc:Loc Calendar.Delete.Recurring.Occurrence}"
                        Style="{StaticResource OutlineButton}" Height="38"
                        Padding="12,0" Margin="0" Click="Occurrence_Click" />
                <Button Grid.Column="4" Content="{loc:Loc Calendar.Delete.Recurring.Series}"
                        Style="{StaticResource DangerButton}" Height="38"
                        Padding="12,0" Margin="0" Click="Series_Click" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
