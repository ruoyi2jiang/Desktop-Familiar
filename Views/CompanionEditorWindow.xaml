                            </StackPanel>
                        </Grid>

                        <controls:FieldHelpLabel Text="{loc:Loc Editor.IdleRandomAssignment}" HelpText="{loc:Loc Editor.IdleRandomAssignment.Help}" Margin="0,12,0,4" />
                        <WrapPanel x:Name="IdleRandomChecksPanel" />

                        <Expander x:Name="AdvancedInteractionsExpander" Style="{StaticResource AdvancedInteractionExpander}" Margin="0,18,0,0">
                            <Expander.Header>
                                <TextBlock Text="{loc:Loc Editor.AdvancedInteractions}" Foreground="{DynamicResource PrimaryAccentBrush}" TextDecorations="Underline" />
                            </Expander.Header>
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Editor.ClickInteractions}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBlock Text="{loc:Loc Editor.AdvancedInteractions.Help}" Foreground="{DynamicResource TextOnPrimaryBackgroundBrush}" Opacity="0.72" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Height="260" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputAccentBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                                        <Grid>
                                            <Image x:Name="ClickAreaPreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock x:Name="ClickAreaPreviewHint" Text="{loc:Loc Editor.CompanionPreview.Empty}" Foreground="{DynamicResource TextOnInputBackgroundBrush}" Opacity="0.72"
                                                       TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" />
                                            <Canvas x:Name="ClickAreaSelectionCanvas" Background="Transparent" Cursor="Cross"
                                                    MouseLeftButtonDown="ClickAreaPreview_MouseLeftButtonDown"
                                                    MouseMove="ClickAreaPreview_MouseMove"
                                                    MouseLeftButtonUp="ClickAreaPreview_MouseLeftButtonUp"
                                                    SizeChanged="ClickAreaPreview_SizeChanged" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{loc:Loc Editor.ClickAreas.Name}" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="ClickAreaNameBox" Style="{StaticResource EditorTextInput}" TextChanged="ClickAreaNameBox_TextChanged" />
                                        <TextBlock Text="{loc:Loc Editor.ClickAreas.Animation}" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="ClickAreaAnimationCombo" Style="{StaticResource EditorComboInput}" DisplayMemberPath="DisplayName" SelectionChanged="ClickAreaAnimation_SelectionChanged" />
                                        <TextBlock Text="{loc:Loc Editor.ClickAreas.Add}" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                                        <ListBox x:Name="ClickAreaList" Height="96" DisplayMemberPath="Name" Style="{StaticResource EditorSceneList}" ItemContainerStyle="{StaticResource EditorSceneListItem}"
                                                 SelectionChanged="ClickAreaList_SelectionChanged" />
                                        <Button Content="{loc:Loc Editor.ClickAreas.Remove}" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="RemoveClickArea_Click" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{DynamicResource PrimaryBackgroundBrush}" Padding="20,14" BorderBrush="{DynamicResource PrimaryAccentBrush}" BorderThickness="0,1,0,0"
                TextElement.Foreground="{DynamicResource TextOnPrimaryBackgroundBrush}">
            <StackPanel>
                <TextBlock x:Name="ValidationHint" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8" />
                <Button x:Name="SaveButton" Content="{loc:Loc Editor.Save.Update}" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
