<Window x:Class="DesktopFamiliar.Views.CompanionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:DesktopFamiliar.Models"
        xmlns:loc="clr-namespace:DesktopFamiliar.Localization"
        xmlns:controls="clr-namespace:DesktopFamiliar.Views.Controls"
        Title="{loc:Loc Editor.Window.Title}" Width="1080" Height="800" MinWidth="900" MinHeight="650"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="BackLinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnSecondaryBackgroundBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="LinkText" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                       FontWeight="{TemplateBinding FontWeight}" FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LinkText" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="LinkText" Property="TextDecorations" Value="Underline" />
                                <Setter TargetName="LinkText" Property="Foreground" Value="{DynamicResource TextOnSecondaryBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EditorTextInput" TargetType="TextBox" BasedOn="{StaticResource ThemedTextInput}" />
        <Style x:Key="EditorCompactTextInput" TargetType="TextBox" BasedOn="{StaticResource EditorTextInput}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="EditorDatePickerTextBox" TargetType="DatePickerTextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Padding="0" Background="Transparent"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <ContentControl x:Name="PART_Watermark" Content="{loc:Loc Editor.Birthday.Placeholder}"
                                            Foreground="{DynamicResource TextOnInputBackgroundBrush}" Opacity="0.68" IsHitTestVisible="False"
                                            VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="PART_Watermark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EditorDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="{x:Static controls:FormFieldMetrics.FieldMargin}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputAccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnInputBackgroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Grid>
                            <Border x:Name="PickerBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="8"
                                    Padding="{x:Static controls:FormFieldMetrics.DatePickerInputPadding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="30" />
                                    </Grid.ColumnDefinitions>
                                    <DatePickerTextBox x:Name="PART_TextBox" Style="{StaticResource EditorDatePickerTextBox}" />
                                    <Button x:Name="PART_Button" Grid.Column="1" Style="{StaticResource DatePickerIconButton}">
                                        <Path Data="M 4 5 L 16 5 L 16 17 L 4 17 Z M 4 9 L 16 9 M 7 3 L 7 7 M 13 3 L 13 7"
                                              Stroke="{DynamicResource InputAccentBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Button>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" StaysOpen="False"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputAccentBrush}"
                                        BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" Padding="4">
                                    <Calendar x:Name="PART_Calendar" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PickerBorder" Property="Background" Value="{DynamicResource InputBackgroundHoverBrush}" />
                                <Setter TargetName="PickerBorder" Property="BorderBrush" Value="{DynamicResource InputAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="PickerBorder" Property="BorderBrush" Value="{DynamicResource InputAccentHoverBrush}" />
                                <Setter TargetName="PickerBorder" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EditorComboInput" TargetType="ComboBox" BasedOn="{StaticResource ThemedComboBox}" />
        <Style x:Key="EditorImportButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,4,6,10" />
        </Style>
        <Style x:Key="EditorPrimaryImportButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,4,0,10" />
        </Style>
        <Style x:Key="EditorSceneList" TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ScrollViewer Style="{StaticResource OverlayScrollViewer}" Focusable="False" Padding="0">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EditorSceneListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnInputBackgroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource InputBackgroundHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource InputBackgroundActiveBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnInputBackgroundBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EditorDataGrid" TargetType="DataGrid" BasedOn="{StaticResource ThemedDataGrid}">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowHeight" Value="30" />
            <Setter Property="MinRowHeight" Value="30" />
            <Setter Property="ColumnHeaderHeight" Value="40" />
            <Setter Property="RowBackground" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource InputBackgroundHoverBrush}" />
            <Setter Property="AlternationCount" Value="2" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource InputAccentBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
        </Style>
        <Style x:Key="EditorDataGridColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource ThemedDataGridColumnHeader}">
            <Setter Property="Background" Value="{DynamicResource PrimaryAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EditorDataGridColumnHeaderTopLeft" TargetType="DataGridColumnHeader" BasedOn="{StaticResource EditorDataGridColumnHeader}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9,0,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EditorDataGridColumnHeaderTopRight" TargetType="DataGridColumnHeader" BasedOn="{StaticResource EditorDataGridColumnHeader}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0,9,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EditorDataGridRowHeader" TargetType="DataGridRowHeader" BasedOn="{StaticResource ThemedDataGridRowHeader}">
            <Setter Property="Background" Value="{DynamicResource PrimaryAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRowHeader">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EditorDataGridSelectAllButton" TargetType="Button" BasedOn="{StaticResource ThemedDataGridSelectAllButton}">
            <Setter Property="Background" Value="{DynamicResource PrimaryAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9,0,0,0" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EditorDataGridCell" TargetType="DataGridCell" BasedOn="{StaticResource ThemedDataGridCell}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnInputBackgroundBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource InputBackgroundActiveBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextOnInputBackgroundBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EditorDataGridText" TargetType="TextBlock" BasedOn="{StaticResource ThemedDataGridText}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,4" />
            <Setter Property="TextAlignment" Value="Left" />
        </Style>
        <Style x:Key="EditorDataGridEditingText" TargetType="TextBox" BasedOn="{StaticResource ThemedDataGridEditingText}">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0" />
            <Setter Property="Padding" Value="0,4" />
        </Style>
        <Style x:Key="DialogHelpButton" TargetType="Button">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="7,0,0,0" />
            <Setter Property="Background" Value="{DynamicResource PrimaryAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryAccentBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="0" />
            <Setter Property="ToolTipService.BetweenShowDelay" Value="0" />
            <Setter Property="ToolTipService.ShowDuration" Value="60000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EditorSlider" TargetType="Slider">
            <Setter Property="Minimum" Value="5" />
            <Setter Property="Maximum" Value="40" />
            <Setter Property="TickFrequency" Value="1" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,6,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryAccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False" Background="{DynamicResource PrimaryAccentBrush}" BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{TemplateBinding Background}" Height="5" CornerRadius="3" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18" Height="18" Background="{DynamicResource PrimaryAccentBrush}" BorderBrush="{DynamicResource PrimaryAccentHoverBrush}" BorderThickness="1">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource PrimaryAccentHoverBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False" Background="{DynamicResource PrimaryBackgroundHoverBrush}" BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{TemplateBinding Background}" Height="5" CornerRadius="3" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EditorTabControl" TargetType="TabControl">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Border Margin="0,48,0,0" ClipToBounds="True">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                            </Border>
                            <TabPanel x:Name="HeaderPanel" IsItemsHost="True" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4" Panel.ZIndex="1" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EditorTabItem" TargetType="TabItem">
            <Setter Property="Width" Value="128" />
            <Setter Property="Height" Value="88" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnSecondaryBackgroundBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Width="128" Height="88" ClipToBounds="False">
                            <Path x:Name="TabBottomOutline" Data="M 2,44 L 64,78.21 L 126,44"
                                  Stroke="{DynamicResource SecondaryAccentBrush}" StrokeThickness="3"
                                  StrokeLineJoin="Miter" StrokeMiterLimit="10" />
                            <Path x:Name="TabRhombus" Data="M 64,12 L 122,44 L 64,76 L 6,44 Z"
                                  Fill="{DynamicResource SecondaryBackgroundActiveBrush}" />
                            <Path x:Name="TabBorder" Data="M 64,12 L 122,44 L 64,76 L 6,44 Z"
                                  Fill="Transparent" Stroke="{DynamicResource SecondaryBackgroundBrush}" StrokeThickness="4"
                                  StrokeLineJoin="Miter" StrokeMiterLimit="10" />
                            <TextBlock x:Name="TabLabel" Text="{TemplateBinding Header}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}" FontSize="12" FontWeight="SemiBold" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabRhombus" Property="Fill" Value="{DynamicResource SecondaryAccentActiveBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnSecondaryAccentBrush}" />
                                <Setter TargetName="TabLabel" Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AdvancedInteractionExpander" TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <ToggleButton x:Name="HeaderToggle" HorizontalAlignment="Left" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0"
                                          Cursor="Hand" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                              Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <StackPanel Orientation="Horizontal">
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                                    <Path x:Name="Chevron" Data="M 1,3 L 7,9 L 13,3" Stroke="{DynamicResource PrimaryAccentBrush}" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" Margin="7,0,0,0">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="0" CenterX="7" CenterY="6" />
                                        </Path.RenderTransform>
                                    </Path>
                                </StackPanel>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" Grid.Row="1" Visibility="Collapsed" ContentSource="Content" Margin="0,14,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180" CenterX="7" CenterY="6" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="CompanionEditorRoot" Background="{DynamicResource PageBackgroundBrush}"
          TextElement.Foreground="{DynamicResource TextOnPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SecondaryBackgroundBrush}" Padding="18,14,18,38" BorderBrush="{DynamicResource SecondaryAccentBrush}" BorderThickness="0,0,0,1"
                TextElement.Foreground="{DynamicResource TextOnSecondaryBackgroundBrush}">
            <DockPanel VerticalAlignment="Top">
                <Button Content="{loc:Loc Editor.Back}" Style="{StaticResource BackLinkButton}" DockPanel.Dock="Left" Click="Back_Click" />
                <TextBlock x:Name="BannerTitle" Text="{loc:Loc Editor.Banner.Default}" Foreground="{DynamicResource TextOnSecondaryBackgroundBrush}" FontSize="21" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,48,0" />
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="0,-49,0,0" Panel.ZIndex="1" Style="{StaticResource EditorTabControl}">
            <TabItem Header="{loc:Loc Editor.Tab.Profile}" Style="{StaticResource EditorTabItem}">
                <ScrollViewer Style="{StaticResource OverlayScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,48,28,28">
                <Border Background="{DynamicResource PrimaryBackgroundBrush}" CornerRadius="14" Padding="22" BorderBrush="{DynamicResource PrimaryAccentBrush}" BorderThickness="1"
                        TextElement.Foreground="{DynamicResource TextOnPrimaryBackgroundBrush}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Editor.Appearance.Title}" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{loc:Loc Editor.Name}" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="NameBox" Style="{StaticResource EditorTextInput}" />

                                <TextBlock Text="{loc:Loc Editor.Birthday}" Style="{StaticResource FieldLabel}" />
                                <DatePicker x:Name="BirthdayPicker" Style="{StaticResource EditorDatePicker}" SelectedDateFormat="Short"
                                            PreviewMouseLeftButtonDown="BirthdayPicker_PreviewMouseLeftButtonDown" />

                                <TextBlock Text="{loc:Loc Editor.FontStyle}" Style="{StaticResource FieldLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="FontCombo" Grid.Column="0" Style="{StaticResource EditorComboInput}" HorizontalAlignment="Stretch" IsEditable="True" IsTextSearchEnabled="True" LostFocus="FontCombo_LostFocus" />
                                    <Button Grid.Column="2" Content="{loc:Loc Editor.ImportFont}" Style="{StaticResource EditorImportButton}" Click="ImportFont_Click" />
                                </Grid>
                                <TextBlock x:Name="ImportedFontLabel" FontSize="12" Foreground="{DynamicResource TextOnPrimaryBackgroundBrush}" Opacity="0.72" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{loc:Loc Editor.UserNickname}" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="UserNicknameBox" Style="{StaticResource EditorTextInput}" />

                                <TextBlock Text="{loc:Loc Editor.FontColor}" Style="{StaticResource FieldLabel}" />
                                <DockPanel Margin="0,4,0,10">
                                    <Button Content="{loc:Loc Editor.OpenColorWheel}" DockPanel.Dock="Right" Click="ChooseColor_Click" />
