<Window x:Class="DesktopFamiliar.Views.ChatModelWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:DesktopFamiliar.Localization"
        Title="{loc:Loc Chat.Models}" Background="{DynamicResource PageBackgroundBrush}" Foreground="{DynamicResource TextOnPageBackgroundBrush}"
        Width="540" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,8">
            <Button x:Name="Discover" Style="{StaticResource OutlineButton}" Content="{loc:Loc Chat.Hub.Find}" Click="Discover_Click" DockPanel.Dock="Right" Margin="10,0,0,0" Visibility="Collapsed"/>
            <TextBlock x:Name="Heading" Text="{loc:Loc Chat.Models}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
        <ScrollViewer x:Name="ModelScroll" Grid.Row="1" Focusable="False"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer" BasedOn="{StaticResource OverlayScrollViewer}">
                    <Style.Triggers>
                        <Trigger Property="ComputedVerticalScrollBarVisibility" Value="Visible">
                            <Setter Property="Padding" Value="0,0,12,0"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel>
                <TextBlock x:Name="FilterHint" Style="{StaticResource MutedPageTextBlock}" Text="{loc:Loc Chat.Fit.Filter}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
                <ListBox x:Name="Choices" MaxHeight="220" ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectionChanged="SelectionChanged" />
                <TextBlock x:Name="DiscoveryStatus" Style="{StaticResource MutedPageTextBlock}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock x:Name="Strengths" Style="{StaticResource MutedPageTextBlock}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,12,0,0"/>
                <TextBlock x:Name="ModelSummary" Style="{StaticResource MutedPageTextBlock}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,4,0,0"/>
                <StackPanel x:Name="ResourceGroup" Visibility="Collapsed" Margin="0,12,0,0">
                    <TextBlock Text="{loc:Loc Chat.Requirements.Title}" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock x:Name="Requirements" Style="{StaticResource MutedPageTextBlock}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
                <TextBlock x:Name="DownloadDetails" Style="{StaticResource MutedPageTextBlock}" TextWrapping="Wrap" Margin="0,8,0,6"/>
                <TextBlock x:Name="Terms"><Hyperlink Click="Terms_Click" Foreground="{DynamicResource PageAccentBrush}"><Run x:Name="TermsLabel" Text="{loc:Loc Chat.Terms}"/></Hyperlink></TextBlock>
                <TextBlock x:Name="Status" Style="{StaticResource MutedPageTextBlock}" TextWrapping="Wrap" Margin="0,8,0,4" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource OutlineButton}" Content="{loc:Loc Common.Cancel}" Click="Cancel_Click"/>
            <Button x:Name="Install" Content="{loc:Loc Chat.Download}" Click="Download_Click" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>
