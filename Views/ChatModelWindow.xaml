<Window x:Class="DesktopFamiliar.Views.ChatModelWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:DesktopFamiliar.Localization"
        Title="{loc:Loc Chat.Models}" Width="540" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24" Background="{DynamicResource PageBackgroundBrush}">
        <TextBlock x:Name="Heading" Text="{loc:Loc Chat.Models}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14"/>
        <ListBox x:Name="Choices" MaxHeight="220" ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectionChanged="SelectionChanged" />
        <TextBlock x:Name="DownloadDetails" TextWrapping="Wrap" Margin="0,14,0,4"/>
        <TextBlock x:Name="Requirements" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,4,0,8" />
        <TextBlock x:Name="Terms"><Hyperlink Click="Terms_Click" Foreground="{DynamicResource PageAccentBrush}"><Run Text="{loc:Loc Chat.Terms}"/></Hyperlink></TextBlock>
        <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,12" AutomationProperties.LiveSetting="Polite"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:Loc Common.Cancel}" Click="Cancel_Click"/>
            <Button x:Name="Install" Content="{loc:Loc Chat.Download}" Click="Download_Click" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </StackPanel>
</Window>
