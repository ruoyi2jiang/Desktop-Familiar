<UserControl x:Class="DesktopFamiliar.Views.Controls.CompanionAvatar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DesktopFamiliar.Localization"
             Focusable="False">
    <Grid>
        <Ellipse Fill="{DynamicResource PageBackgroundHoverBrush}" Stroke="{DynamicResource PageAccentBrush}" StrokeThickness="1" />
        <Ellipse Margin="1" RenderOptions.BitmapScalingMode="HighQuality">
            <Ellipse.Fill><ImageBrush x:Name="Picture" Stretch="UniformToFill" /></Ellipse.Fill>
        </Ellipse>
        <TextBlock x:Name="Placeholder" Text="{loc:Loc Chat.PetIcon}" Foreground="{DynamicResource TextOnPageBackgroundBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</UserControl>
