<UserControl x:Class="DesktopFamiliar.Views.Controls.CompanionCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DesktopFamiliar.Localization"
             Width="385" Height="194" Margin="8">
    <Border x:Name="CardBorder" Padding="20" CornerRadius="14" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="118" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="PreviewBorder" Grid.Column="0" Height="152" Padding="6"
                    BorderBrush="{DynamicResource PageAccentBrush}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="PreviewPlaceholder" Text="{loc:Loc Chat.PetIcon}"
                               Foreground="{DynamicResource TextOnPageBackgroundBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid Grid.Column="2" Height="152" VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <Button x:Name="SelectButton" DockPanel.Dock="Right" Style="{StaticResource OutlineButton}"
                            Height="30" Padding="8,0" Margin="0" Click="Select_Click" />
                    <Border x:Name="SelectedIndicatorHost" DockPanel.Dock="Right" Width="30" Height="30"
                            Background="Transparent">
                        <Border Width="22" Height="22" Background="{DynamicResource PageAccentBrush}"
                                CornerRadius="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#x2713;" Foreground="{DynamicResource TextOnPageAccentBrush}"
                                       FontWeight="SemiBold" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Border>
                    <TextBlock x:Name="NameText" FontSize="22" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextOnPageBackgroundBrush}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>

                <TextBlock x:Name="SummaryText" Grid.Row="1" Margin="0,10,0,8" MinHeight="34"
                           Foreground="{DynamicResource TextOnPageBackgroundBrush}" TextWrapping="Wrap" />

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="ConfigureButton" Style="{StaticResource OutlineButton}"
                            Height="36" Padding="4,0" Margin="0" FontSize="11" HorizontalAlignment="Stretch" Click="Configure_Click" />
                    <Button Grid.Column="2" x:Name="ExportButton" Style="{StaticResource OutlineButton}"
                            Height="36" Padding="4,0" Margin="0" FontSize="11" HorizontalAlignment="Stretch" Click="Export_Click" />
                    <Button Grid.Column="4" x:Name="DeleteButton" Style="{StaticResource DangerButton}"
                            Height="36" Padding="4,0" Margin="0" FontSize="11" HorizontalAlignment="Stretch" Click="Delete_Click" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
