<UserControl x:Class="DesktopFamiliar.Views.Controls.ChatHistoryPetRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DesktopFamiliar.Views.Controls"
             xmlns:loc="clr-namespace:DesktopFamiliar.Localization"
             Focusable="False">
    <StackPanel>
        <Border x:Name="PetDivider" Height="1" Background="{DynamicResource TextOnPageBackgroundBrush}"
                Opacity="0.2" IsHitTestVisible="False" />
        <Grid x:Name="RowBody" Margin="8,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:CompanionAvatar x:Name="Avatar" Width="48" Height="48" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="PetName" Style="{StaticResource PageTextBlock}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="HistorySize" Style="{StaticResource MutedPageTextBlock}" Margin="0,3,0,0" />
            </StackPanel>
            <Button x:Name="ClearButton" Grid.Column="2" Content="{loc:Loc Chat.Clear}"
                    MinHeight="32" Padding="12,4" Margin="10,0,0,0" VerticalAlignment="Center" />
        </Grid>
    </StackPanel>
</UserControl>
