<Window x:Class="DesktopFamiliar.Views.ChatHistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:DesktopFamiliar.Localization"
        Title="{loc:Loc Chat.History}" Width="760" Height="510" MinWidth="500" MinHeight="320" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="ScrollViewer" BasedOn="{StaticResource OverlayScrollViewer}">
            <Style.Triggers>
                <Trigger Property="ComputedVerticalScrollBarVisibility" Value="Visible">
                    <Setter Property="Padding" Value="0,0,12,0" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border x:Name="Surface" Background="{DynamicResource PageBackgroundBrush}" TextElement.Foreground="{DynamicResource TextOnPageBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock x:Name="Heading" FontSize="24" FontWeight="SemiBold" Margin="18,12"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="175"/><ColumnDefinition Width="1"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <ListBox x:Name="Pets" Margin="9,9,0,9" SelectionChanged="SelectionChanged" Background="{DynamicResource PageBackgroundBrush}" Foreground="{DynamicResource TextOnPageBackgroundBrush}"
                     ItemContainerStyle="{StaticResource ChatHistoryPetItem}" AutomationProperties.Name="{loc:Loc Chat.Pets}">
                <ListBox.Resources>
                    <Thickness x:Key="OverlayScrollBarMargin">0,4,0,4</Thickness>
                </ListBox.Resources>
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}">
                            <ScrollViewer Focusable="False" CanContentScroll="True" Padding="0,0,2,0"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </ListBox.Template>
            </ListBox>
            <Border x:Name="Divider" Grid.Column="1" Background="{DynamicResource PageAccentBrush}" Opacity="0.5"/>
            <ScrollViewer Grid.Column="2" x:Name="Timeline" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Messages" Margin="14"/>
            </ScrollViewer>
            <ScrollViewer x:Name="ManageScroll" Grid.ColumnSpan="3" Visibility="Collapsed" Focusable="False"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ManagedPets" Margin="0,0,6,0" Focusable="False" AutomationProperties.Name="{loc:Loc Chat.Pets}" />
            </ScrollViewer>
            <TextBlock x:Name="Status" Grid.ColumnSpan="3" Visibility="Collapsed" Margin="18" HorizontalAlignment="Center"
                       VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
        </Grid>
    </Grid>
    </Border>
</Window>
