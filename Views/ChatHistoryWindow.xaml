<Window x:Class="DesktopFamiliar.Views.ChatHistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:DesktopFamiliar.Localization"
        Title="{loc:Loc Chat.History}" Width="760" Height="510" MinWidth="500" MinHeight="320" WindowStartupLocation="CenterScreen">
    <Grid Background="{DynamicResource PageBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="Heading" FontSize="24" FontWeight="SemiBold" Margin="18,12"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="175"/><ColumnDefinition Width="1"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <ListBox x:Name="Pets" Margin="8" SelectionChanged="SelectionChanged" Background="{DynamicResource PageBackgroundBrush}" BorderThickness="0"
                     AutomationProperties.Name="{loc:Loc Chat.Pets}"/>
            <Border Grid.Column="1" Background="{DynamicResource PageAccentBrush}" Opacity="0.5"/>
            <ScrollViewer Grid.Column="2" x:Name="Timeline" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Messages" Margin="14"/>
            </ScrollViewer>
        </Grid>
        <StackPanel x:Name="ClearPanel" Grid.Row="2" Visibility="Collapsed" Margin="16">
            <CheckBox x:Name="IncludeNotes" Content="{loc:Loc Chat.ClearNotes}"/>
            <Button x:Name="ClearButton" Content="{loc:Loc Chat.ClearSelected}" HorizontalAlignment="Right" Click="Clear_Click"/>
        </StackPanel>
    </Grid>
</Window>
