<Window x:Class="DesktopFamiliar.Views.ChatPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DesktopFamiliar.Localization" Title="{loc:Loc Chat.Title}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ResizeMode="NoResize" SizeToContent="Height" PreviewKeyDown="Prompt_KeyDown">
    <Window.Resources>
        <Style x:Key="PromptAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="{Binding ActualHeight, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Window.Resources>
    <Border x:Name="Surface" CornerRadius="12" Padding="11,9"
            BorderBrush="{DynamicResource OverlayBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Input" Margin="0" MaxLength="1200"
                     AutomationProperties.Name="{loc:Loc Chat.Prompt}" ToolTip="{loc:Loc Chat.Prompt}"
                     FontFamily="{Binding ElementName=Surface,Path=(TextElement.FontFamily)}" />
            <Button x:Name="TalkButton" Grid.Column="1" Style="{StaticResource PromptAction}"
                    AutomationProperties.Name="{loc:Loc Voice.Hold}" ToolTip="{loc:Loc Voice.Hold}"
                    PreviewMouseLeftButtonDown="Talk_Down" PreviewMouseLeftButtonUp="Talk_Up" LostMouseCapture="Talk_LostCapture"
                    PreviewKeyDown="Talk_KeyDown" PreviewKeyUp="Talk_KeyUp">
                <Path Width="12" Height="18" Stretch="Fill"
                      Data="M 7,2 A 2,2 0 0 1 11,2 L 11,8 A 2,2 0 0 1 7,8 Z M 4,7 Q 4,14 9,14 Q 14,14 14,7 M 9,14 V 17 M 6,17 H 12"
                      Stroke="{Binding Foreground,ElementName=TalkButton}" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Button>
            <Button x:Name="SendButton" Grid.Column="2" Style="{StaticResource PromptAction}" Click="Send_Click"
                    ToolTip="{loc:Loc Chat.Send}" AutomationProperties.Name="{loc:Loc Chat.Send}">
                <Path Width="15" Height="13" Stretch="Fill" Data="M 14,1 V 7 H 1 M 6,2 L 1,7 L 6,12"
                      Stroke="{Binding Foreground, ElementName=SendButton}" StrokeThickness="1.6"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Button>
            <Button x:Name="CloseButton" Grid.Column="3" Width="24" Height="24" VerticalAlignment="Center"
                    Margin="4,0,0,0" Padding="0" Click="Close_Click" Background="{DynamicResource OverlaySurfaceBrush}"
                    Foreground="{DynamicResource TextOnOverlayBrush}" ToolTip="{loc:Loc Chat.ClosePrompt}" AutomationProperties.Name="{loc:Loc Chat.ClosePrompt}">
                <Path Width="10" Height="10" Stretch="Fill" Data="M 2,2 L 10,10 M 10,2 L 2,10"
                      Stroke="{Binding Foreground, ElementName=CloseButton}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Button>
            <TextBlock x:Name="VoiceStatus" Grid.Row="1" Grid.ColumnSpan="4" Visibility="Collapsed" Margin="0,4,0,0"
                       Foreground="{DynamicResource TextOnOverlayBrush}" FontSize="11" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
        </Grid>
    </Border>
</Window>
