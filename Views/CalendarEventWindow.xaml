<Window x:Class="DesktopFamiliar.Views.CalendarEventWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DesktopFamiliar.Localization"
        Title="{loc:Loc Calendar.Window.Title}" Width="1060" Height="780" MinWidth="860" MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="CalendarDayHeader" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBackgroundBrush}" />
        </Style>
    </Window.Resources>

    <Grid x:Name="CalendarRoot" Background="{DynamicResource PageBackgroundBrush}"
          TextElement.Foreground="{DynamicResource TextOnPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource SecondaryAccentBrush}" BorderThickness="0,0,0,1" Padding="28,18"
                TextElement.Foreground="{DynamicResource TextOnSecondaryBackgroundBrush}">
            <StackPanel>
                <TextBlock Text="{loc:Loc Calendar.Header}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextOnSecondaryBackgroundBrush}" />
                <TextBlock Text="{loc:Loc Calendar.Subtitle}" Margin="0,5,0,0" Opacity="0.82" Foreground="{DynamicResource TextOnSecondaryBackgroundBrush}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <Button Content="{loc:Loc Calendar.NewEvent}" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" Height="38" Padding="16,0" Margin="0" Click="NewEvent_Click" />
                <Button Content="{loc:Loc Calendar.Month.Today}" Style="{StaticResource OutlineButton}" DockPanel.Dock="Right" Height="38" Padding="14,0" Margin="0,0,8,0" Click="Today_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="PreviousMonthButton" Content="&lt;" Style="{StaticResource OutlineButton}" Width="38" Height="38" Padding="0" Margin="0"
                            ToolTip="{loc:Loc Calendar.Month.Previous}" Click="PreviousMonth_Click" />
                    <ComboBox x:Name="MonthSelector" Width="150" Height="38" Margin="8,0,0,0" DisplayMemberPath="Text"
                              ToolTip="{loc:Loc Calendar.Month.SelectMonth}" SelectionChanged="CalendarMonthSelection_Changed" />
                    <ComboBox x:Name="YearSelector" Width="92" Height="38" Margin="8,0" ToolTip="{loc:Loc Calendar.Month.SelectYear}"
                              SelectionChanged="CalendarMonthSelection_Changed" />
                    <Button Content="&gt;" Style="{StaticResource OutlineButton}" Width="38" Height="38" Padding="0" Margin="0"
                            ToolTip="{loc:Loc Calendar.Month.Next}" Click="NextMonth_Click" />
                </StackPanel>
            </DockPanel>

            <UniformGrid Grid.Row="1" Columns="7" Margin="2,0">
                <TextBlock Text="{loc:Loc Calendar.Day.Sunday}" Style="{StaticResource CalendarDayHeader}" />
                <TextBlock Text="{loc:Loc Calendar.Day.Monday}" Style="{StaticResource CalendarDayHeader}" />
                <TextBlock Text="{loc:Loc Calendar.Day.Tuesday}" Style="{StaticResource CalendarDayHeader}" />
                <TextBlock Text="{loc:Loc Calendar.Day.Wednesday}" Style="{StaticResource CalendarDayHeader}" />
                <TextBlock Text="{loc:Loc Calendar.Day.Thursday}" Style="{StaticResource CalendarDayHeader}" />
                <TextBlock Text="{loc:Loc Calendar.Day.Friday}" Style="{StaticResource CalendarDayHeader}" />
                <TextBlock Text="{loc:Loc Calendar.Day.Saturday}" Style="{StaticResource CalendarDayHeader}" />
            </UniformGrid>

            <Border Grid.Row="2" Background="{DynamicResource PrimaryBackgroundBrush}" BorderBrush="{DynamicResource PrimaryAccentBrush}" BorderThickness="1" CornerRadius="14" Padding="2" ClipToBounds="True"
                    TextElement.Foreground="{DynamicResource TextOnPrimaryBackgroundBrush}">
                <UniformGrid x:Name="CalendarGrid" Columns="7" Rows="6" />
            </Border>
        </Grid>

        <Grid x:Name="EventEditorOverlay" Grid.RowSpan="2" Background="{DynamicResource OverlaySurfaceBrush}" Visibility="Collapsed"
              MouseLeftButtonDown="EventEditorOverlay_MouseLeftButtonDown">
            <Border x:Name="EventEditorCard" Width="570" MaxHeight="680" Background="{DynamicResource PrimaryBackgroundBrush}" BorderBrush="{DynamicResource PrimaryAccentBrush}" BorderThickness="1" CornerRadius="16" ClipToBounds="True"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    TextElement.Foreground="{DynamicResource TextOnPrimaryBackgroundBrush}">
                <ScrollViewer Style="{StaticResource OverlayScrollViewer}" VerticalScrollBarVisibility="Auto">
                    <Border Padding="24">
                        <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Calendar.EventDetails}" Style="{StaticResource SectionTitle}"
                                       Margin="0" VerticalAlignment="Center" />
                            <Border x:Name="EventStatusBadge" Grid.Column="1" Margin="10,0,0,0" Padding="9,4"
                                    CornerRadius="10" BorderThickness="1" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="EventStatusText" FontSize="11" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </Border>
                            <Button Grid.Column="3" Content="{loc:Loc Common.Cancel}" Style="{StaticResource OutlineButton}"
                                    Height="34" Padding="12,0" Margin="0" Click="CancelEdit_Click" />
                        </Grid>
                        <TextBlock Text="{loc:Loc Calendar.Title}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="TitleInput" Style="{StaticResource ThemedTextInput}" />
                        <TextBlock Text="{loc:Loc Calendar.Notes}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="NotesInput" Style="{StaticResource ThemedMultilineTextInput}" Height="68" />

                        <Border Height="1" Background="{DynamicResource PrimaryAccentBrush}" Opacity="0.5" Margin="0,10,0,18" />
                        <TextBlock Text="{loc:Loc Calendar.Schedule}" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{loc:Loc Calendar.Date}" Style="{StaticResource FieldLabel}" />
                                <DatePicker x:Name="StartDatePicker" SelectedDateChanged="DatePicker_SelectedDateChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{loc:Loc Calendar.EndDate}" Style="{StaticResource FieldLabel}" />
                                <DatePicker x:Name="EndDatePicker" SelectedDateChanged="DatePicker_SelectedDateChanged" />
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{loc:Loc Calendar.Category}" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="CategoryCombo" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{loc:Loc Calendar.Recurrence}" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="RecurrenceCombo" SelectionChanged="RecurrenceCombo_SelectionChanged" />
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="AllDayCheck" Content="{loc:Loc Calendar.AllDay}" Checked="AllDayCheck_Changed" Unchecked="AllDayCheck_Changed" />
                        <Grid x:Name="TimeRangePanel" Margin="0,8,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{loc:Loc Calendar.StartTime}" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="StartTimeCombo" SelectionChanged="StartTimeCombo_SelectionChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{loc:Loc Calendar.EndTime}" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="EndTimeCombo" />
                            </StackPanel>
                        </Grid>
                        <WrapPanel x:Name="WeekdaysPanel" Margin="0,0,0,8">
                            <CheckBox x:Name="SundayCheck" Content="{loc:Loc Calendar.Day.Sunday}" Margin="0,0,14,4" />
                            <CheckBox x:Name="MondayCheck" Content="{loc:Loc Calendar.Day.Monday}" Margin="0,0,14,4" />
                            <CheckBox x:Name="TuesdayCheck" Content="{loc:Loc Calendar.Day.Tuesday}" Margin="0,0,14,4" />
                            <CheckBox x:Name="WednesdayCheck" Content="{loc:Loc Calendar.Day.Wednesday}" Margin="0,0,14,4" />
                            <CheckBox x:Name="ThursdayCheck" Content="{loc:Loc Calendar.Day.Thursday}" Margin="0,0,14,4" />
                            <CheckBox x:Name="FridayCheck" Content="{loc:Loc Calendar.Day.Friday}" Margin="0,0,14,4" />
                            <CheckBox x:Name="SaturdayCheck" Content="{loc:Loc Calendar.Day.Saturday}" Margin="0,0,14,4" />
                        </WrapPanel>
                        <CheckBox x:Name="UrgentCheck" Content="{loc:Loc Calendar.Urgent}" Margin="0,4,0,0" />

                        <Border Height="1" Background="{DynamicResource PrimaryAccentBrush}" Opacity="0.5" Margin="0,18,0,18" />
                        <TextBlock Text="{loc:Loc Calendar.Reminder}" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="ReminderEnabledCheck" Content="{loc:Loc Calendar.ReminderEnabled}" Checked="ReminderEnabledCheck_Changed" Unchecked="ReminderEnabledCheck_Changed" />
                        <Grid x:Name="ReminderOptionsPanel" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{loc:Loc Calendar.RemindBefore}" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="AdvanceMinutesInput" Style="{StaticResource ThemedTextInput}" />
                                <TextBlock Text="{loc:Loc Calendar.Minutes}" FontSize="12" Opacity="0.7" Margin="0,-8,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{loc:Loc Calendar.SnoozeFrequency}" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="SnoozeMinutesInput" Style="{StaticResource ThemedTextInput}" />
                                <TextBlock Text="{loc:Loc Calendar.Minutes}" FontSize="12" Opacity="0.7" Margin="0,-8,0,0" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{loc:Loc Calendar.ReminderHelp}" TextWrapping="Wrap" Opacity="0.7" Margin="0,14,0,10" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="DeleteButton" Grid.Column="0" Content="{loc:Loc Calendar.Delete}" Style="{StaticResource DangerButton}"
                                        Height="38" Padding="16,0" Margin="0" Click="Delete_Click" />
                                <Button Grid.Column="2" Content="{loc:Loc Calendar.Save}" Style="{StaticResource PrimaryButton}"
                                        Height="38" Margin="0" Click="Save_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
