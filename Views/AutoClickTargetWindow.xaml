<Window x:Class="DesktopFamiliar.Views.AutoClickTargetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DesktopFamiliar.Localization"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" Focusable="True"
        KeyDown="Window_KeyDown" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid Background="{DynamicResource OverlaySurfaceBrush}" Opacity="0.92"
          TextElement.Foreground="{DynamicResource TextOnOverlayBrush}">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,20" CornerRadius="12"
                Background="{DynamicResource OverlaySurfaceHoverBrush}" BorderBrush="{DynamicResource OverlayBorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{loc:Loc AutoClick.Target.Title}" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="{loc:Loc AutoClick.Target.Description}" Margin="0,7,0,0" TextWrapping="Wrap" MaxWidth="380" TextAlignment="Center" />
                <TextBlock Text="{loc:Loc AutoClick.Target.Cancel}" Margin="0,10,0,0" Opacity="0.76" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
