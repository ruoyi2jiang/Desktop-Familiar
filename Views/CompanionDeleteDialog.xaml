<Window x:Class="DesktopFamiliar.Views.CompanionDeleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DesktopFamiliar.Localization"
        Title="{loc:Loc Library.Delete.Title}"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="{DynamicResource PrimaryBackgroundBrush}"
            BorderBrush="{DynamicResource PrimaryAccentBrush}"
            BorderThickness="1" CornerRadius="14" Padding="24"
            TextElement.Foreground="{DynamicResource TextOnPrimaryBackgroundBrush}">
        <StackPanel>
            <TextBlock Text="{loc:Loc Library.Delete.Title}" FontSize="21" FontWeight="SemiBold" />
            <TextBlock x:Name="MessageText" Margin="0,12,0,22" TextWrapping="Wrap" FontSize="14" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="{loc:Loc Common.Cancel}" Style="{StaticResource OutlineButton}"
                        Height="38" Padding="14,0" Margin="0" Click="Cancel_Click" />
                <Button Grid.Column="2" Content="{loc:Loc Library.Delete.KeepResources}" Style="{StaticResource OutlineButton}"
                        Height="38" Padding="12,0" Margin="0" Click="KeepResources_Click" />
                <Button Grid.Column="4" Content="{loc:Loc Library.Delete.WithResources}" Style="{StaticResource DangerButton}"
                        Height="38" Padding="12,0" Margin="0" Click="DeleteResources_Click" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
